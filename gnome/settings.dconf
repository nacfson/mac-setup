# GNOME settings for mac-setup. Apply with: dconf load / < gnome/settings.dconf

[org/gnome/shell/keybindings]
switch-to-application-1=['<Super>1']
switch-to-application-2=['<Super>2']
switch-to-application-3=['<Super>3']
switch-to-application-4=['<Super>4']
switch-to-application-5=['<Super>5']
switch-to-application-6=['<Super>6']
switch-to-application-7=['<Super>7']
switch-to-application-8=['<Super>8']
switch-to-application-9=['<Super>9']
toggle-overview=['<Alt>space']

[org/gnome/desktop/wm/keybindings]
activate-window-menu=@as []
switch-input-source=['<Super>space', '<Control>space', 'XF86Keyboard']
switch-input-source-backward=['<Shift><Super>space', '<Shift><Control>space', '<Shift>XF86Keyboard']

[org/gnome/desktop/input-sources]
sources=[('xkb', 'us'), ('ibus', 'hangul')]
xkb-options=['korean:ralt_hangul', 'korean:rctrl_hanja']

[org/gnome/shell/extensions/macosdock]
enable-keyboard-nav=false
toggle-dock=['<Super>d']

[org/freedesktop/ibus/engine/hangul]
disable-latin-mode=true
initial-input-mode='hangul'
switch-keys='Hangul,Shift+space'
